<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de Pixel To-Do: encabezado (abre la app) y hasta 5 pendientes que se completan al tocarlos -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/notif_cat" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/silkscreen"
                    android:maxLines="1"
                    android:text="@string/widget_title"
                    android:textColor="#F4B942"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/widget_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/pixelify"
                    android:maxLines="1"
                    android:textColor="#B3A5C0"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#0F0B14" />

        <LinearLayout
            android:id="@+id/row_0"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/check_0"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_check_off" />

            <TextView
                android:id="@+id/title_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/pixelify"
                android:maxLines="1"
                android:textColor="#F3E9D6"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/meta_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/silkscreen"
                android:maxLines="1"
                android:textColor="#F4B942"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/check_1"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_check_off" />

            <TextView
                android:id="@+id/title_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/pixelify"
                android:maxLines="1"
                android:textColor="#F3E9D6"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/meta_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/silkscreen"
                android:maxLines="1"
                android:textColor="#F4B942"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/check_2"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_check_off" />

            <TextView
                android:id="@+id/title_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/pixelify"
                android:maxLines="1"
                android:textColor="#F3E9D6"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/meta_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/silkscreen"
                android:maxLines="1"
                android:textColor="#F4B942"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/check_3"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_check_off" />

            <TextView
                android:id="@+id/title_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/pixelify"
                android:maxLines="1"
                android:textColor="#F3E9D6"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/meta_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/silkscreen"
                android:maxLines="1"
                android:textColor="#F4B942"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/check_4"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_check_off" />

            <TextView
                android:id="@+id/title_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/pixelify"
                android:maxLines="1"
                android:textColor="#F3E9D6"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/meta_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/silkscreen"
                android:maxLines="1"
                android:textColor="#F4B942"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fontFamily="@font/pixelify"
            android:gravity="center"
            android:text="@string/widget_empty"
            android:textColor="#B3A5C0"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/pixelify"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#B3A5C0"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
